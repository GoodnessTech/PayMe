{
  "name": "payme",
  "private": true,
  "version": "1.0.0",
  "description": "Private invoice payment links on NEAR: NEAR AI Cloud (TEE) parsing, NEAR Intents quotes, testnet smart contract.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.api.json && tsc --noEmit -p tsconfig.node.json",
    "contract:test": "cd contract && cargo test",
    "contract:build": "cd contract && cargo near build non-reproducible-wasm --no-abi",
    "contract:deploy": "npm run contract:build && node scripts/deploy-contract.mjs",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build",
    "verify:sample": "node scripts/verify-sample-attestation.mjs",
    "invoice": "node scripts/get-invoice.mjs"
  },
  "dependencies": {
    "@hot-labs/near-connect": "^0.12.0",
    "@phala/dcap-qvl": "^0.7.1",
    "ethers": "^6.17.0",
    "lucide-react": "^0.446.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
