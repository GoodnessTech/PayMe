{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.api.json && tsc --noEmit -p tsconfig.node.json",
    "contract:test": "cd contract && cargo test",
    "contract:build": "cd contract && cargo near build non-reproducible-wasm --no-abi",
    "contract:deploy": "npm run contract:build && node scripts/deploy-contract.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@phala/dcap-qvl": "^0.7.1",
    "@supabase/supabase-js": "^2.57.4",
    "ethers": "^6.17.0",
    "lucide-react": "^0.446.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
