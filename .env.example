# Copy to .env and fill in. Never commit .env.
# Server-only variables (no VITE_ prefix) are never sent to the browser.

# --- NEAR AI Cloud (private invoice parsing in a TEE) ---
# API key from cloud.near.ai (starts with "sk-"). Server only.
# If missing or failing, /api/parse-invoice uses a clearly labelled local regex
# parser and returns verified: false.
NEAR_AI_API_KEY=
# Model for invoice extraction. Must run in NEAR's own TEE (has a model
# attestation) and support structured outputs. Chosen from GET /v1/models:
# non-reasoning instruct model, cheap ($0.15 in / $0.55 out per 1M tokens).
NEAR_AI_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# --- NEAR Intents 1Click (dry-run cross-chain quotes; no funds move) ---
# Optional partner JWT from https://partners.near-intents.org. Without it,
# quotes include an extra 0.25% platform fee.
ONECLICK_JWT=
# An EXISTING mainnet NEAR account used only as the recipient in dry-run
# quotes (1Click rejects non-existent accounts, even for dry runs). Nothing is
# ever sent to it. Set your own mainnet account if you have one.
INTENTS_QUOTE_RECIPIENT=intents.near

# --- NEAR testnet contract (frontend + `npm run contract:deploy`) ---
VITE_CONTRACT_ID=payme-invoices.testnet
# This project is testnet-only.
VITE_NEAR_NETWORK=testnet
